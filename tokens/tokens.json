{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "MINIMAL design tokens — source of truth. `primitive` is theme-independent raw values. `semantic.base` is theme-agnostic roles, `semantic.light` / `semantic.dark` are per-theme color roles, `semantic.derived` are roles computed from other roles at runtime (color-mix), so they follow whatever scope sets signal/paper/theme. `variant` holds attribute-scoped overrides: data-signal, data-paper, data-diff, data-dialect. {a.b} refers to a primitive path, or to a semantic role when no primitive matches. Regenerate dist/ with `npm run build`.",

  "primitive": {
    "color": {
      "$type": "color",
      "paper": { "$value": "#FFFFFF", "$description": "기본 종이 — 순백" },
      "paperWarm": { "$value": "#E8E7E0", "$description": "따뜻한 종이 — sixmaterials 계열" },
      "paperWarmDeep": { "$value": "#DCDBD3" },
      "ink": { "$value": "#111111", "$description": "라이트 테마의 잉크 — 선, 글자, 선택 반전" },
      "night": { "$value": "#0D0D0D", "$description": "다크 테마의 종이 — weft-2" },
      "chalk": { "$value": "#EDEDEA", "$description": "다크 테마의 잉크" },

      "gray": {
        "$description": "따뜻한 기운이 아주 약간 있는 뉴트럴. 라벨/힌트/비활성/선에만 쓴다.",
        "50":  { "$value": "#F4F4F2" },
        "100": { "$value": "#EBEBE8" },
        "200": { "$value": "#D6D6D3" },
        "300": { "$value": "#BDBDBA" },
        "400": { "$value": "#A6A6A2" },
        "500": { "$value": "#8F8F8B" },
        "600": { "$value": "#6B6B68" },
        "700": { "$value": "#5A5A57" },
        "750": { "$value": "#4D4D4A" },
        "800": { "$value": "#464644" },
        "850": { "$value": "#2E2E2D" },
        "900": { "$value": "#1F1F1E" },
        "925": { "$value": "#161615" }
      },

      "red": {
        "$description": "기본 시그널. weft/mosaic/bubble/field의 마커 레드에서 채집.",
        "mark":     { "$value": "#F23A22" },
        "fill":     { "$value": "#D42A14", "$description": "흰 글자를 얹는 채움 — 4.5:1 확보" },
        "text":     { "$value": "#B0220E", "$description": "작은 시그널 글자 — 따뜻한 종이의 hover 위에서도 4.5:1" },
        "markDark": { "$value": "#FF5A43" },
        "textDark": { "$value": "#FF6A55" }
      },
      "blue": {
        "$description": "tide-2의 프리즈 블루.",
        "mark":     { "$value": "#2246FF" },
        "text":     { "$value": "#1D3DE6" },
        "markDark": { "$value": "#6F86FF" },
        "textDark": { "$value": "#8B9DFF" }
      },
      "orange": {
        "$description": "cut의 오렌지. 따뜻한 종이와는 3:1이 안 나와 함께 쓰지 않는다.",
        "mark":     { "$value": "#FE4E00" },
        "fill":     { "$value": "#C23A00" },
        "text":     { "$value": "#A83200" },
        "textDark": { "$value": "#FF7A3D" }
      },
      "diff": {
        "$description": "data-diff=\"hue\" 전용. 줄 배경 틴트로만 쓴다 — 글자색으로 쓰지 않는다.",
        "add":     { "$value": "#1A7F37" },
        "del":     { "$value": "#CF222E" },
        "addDark": { "$value": "#3FB950" },
        "delDark": { "$value": "#F85149" }
      }
    },

    "font": {
      "family": {
        "mono": { "$value": ["IBM Plex Mono", "JetBrains Mono", "SFMono-Regular", "Menlo", "Pretendard", "monospace"], "$description": "라벨·버튼·값 표·힌트 — 계기판의 목소리" },
        "sans": { "$value": ["Inter Tight", "Helvetica Neue", "Helvetica", "Arial", "Pretendard", "sans-serif"], "$description": "큰 숫자(리드아웃)·워드마크·드문 본문" }
      },
      "size": {
        "2xs": { "$value": "10px" },
        "xs":  { "$value": "11px" },
        "sm":  { "$value": "12px" },
        "md":  { "$value": "14px" },
        "lg":  { "$value": "16px" },
        "xl":  { "$value": "20px" },
        "2xl": { "$value": "28px" }
      },
      "readout": {
        "$description": "리드아웃(큰 숫자) 전용 사이즈. 본문 스케일과 분리한다.",
        "sm": { "$value": "28px" },
        "md": { "$value": "44px" },
        "lg": { "$value": "64px" },
        "xl": { "$value": "104px" }
      },
      "weight": {
        "light":    { "$value": 300 },
        "regular":  { "$value": 400 },
        "medium":   { "$value": 500 },
        "semibold": { "$value": 600 }
      },
      "tracking": {
        "tight": { "$value": "-0.035em", "$description": "리드아웃" },
        "none":  { "$value": "0" },
        "label": { "$value": "0.14em", "$description": "모든 대문자 라벨" },
        "wide":  { "$value": "0.24em", "$description": "서브타이틀·섹션 라벨" },
        "mark":  { "$value": "0.55em", "$description": "워드마크 T I D E" }
      },
      "leading": {
        "none":   { "$value": 1 },
        "tight":  { "$value": 1.2 },
        "normal": { "$value": 1.55 }
      }
    },

    "space": {
      "$description": "4px 그리드.",
      "0":  { "$value": "0" },
      "1":  { "$value": "4px" },
      "2":  { "$value": "8px" },
      "3":  { "$value": "12px" },
      "4":  { "$value": "16px" },
      "5":  { "$value": "20px" },
      "6":  { "$value": "24px" },
      "8":  { "$value": "32px" },
      "10": { "$value": "40px" },
      "12": { "$value": "48px" },
      "16": { "$value": "64px" }
    },

    "size": {
      "control": {
        "sm": { "$value": "24px" },
        "md": { "$value": "32px" },
        "lg": { "$value": "40px" }
      },
      "ruler": { "$value": "22px", "$description": "눈금자 높이 (눈금 12px + 포인터 10px)" },
      "panel": { "$value": "460px", "$description": "우측 컨트롤 패널 기본 폭" }
    },

    "stroke": {
      "hair": { "$value": "1px", "$description": "모든 테두리 — 유일한 기본 두께" },
      "rule": { "$value": "1.5px", "$description": "헤더 아래 큰 구분선, 테이블 그룹 끝" },
      "mark": { "$value": "3px", "$description": "재생 중 밑줄, 진행 바" }
    },

    "radius": {
      "none": { "$value": "0" },
      "soft": { "$value": "10px" },
      "pill": { "$value": "999px" }
    },

    "motion": {
      "duration": {
        "instant": { "$value": "0ms" },
        "quick":   { "$value": "80ms" },
        "base":    { "$value": "160ms" }
      },
      "ease": {
        "linear": { "$value": "linear" },
        "out":    { "$value": "cubic-bezier(0.2, 0, 0, 1)" }
      }
    }
  },

  "semantic": {
    "base": {
      "radius": {
        "control": { "$value": "{radius.none}" },
        "panel":   { "$value": "{radius.none}" }
      },
      "font": {
        "control": { "$value": "{font.family.mono}", "$description": "버튼/칩의 글꼴. soft 방언에서 sans로 바뀐다." },
        "controlCase": { "$value": "uppercase" },
        "controlTracking": { "$value": "{font.tracking.label}" }
      },
      "diff": {
        "on":    { "$value": "0", "$description": "data-diff=\"hue\"가 1로 켠다" },
        "allow": { "$value": "0", "$description": "시그널이 허용하는지 — 기본(red)은 0, blue 변형만 1" }
      }
    },

    "light": {
      "scheme": { "$value": "light", "$description": "CSS color-scheme — 네이티브 스크롤바·폼 컨트롤·자동완성 색을 테마에 맞춘다" },
      "bg": {
        "canvas": { "$value": "{color.paper}" },
        "panel":  { "$value": "{color.paper}" },
        "sunken": { "$value": "{color.gray.50}" },
        "hover":  { "$value": "{color.gray.100}" },
        "scrim":  { "$value": "rgba(255, 255, 255, 0.72)" }
      },
      "ink": {
        "primary":   { "$value": "{color.ink}" },
        "secondary": { "$value": "{color.gray.700}" },
        "tertiary":  { "$value": "{color.gray.600}" },
        "disabled":  { "$value": "{color.gray.300}" }
      },
      "line": {
        "strong":  { "$value": "{color.ink}", "$description": "컨트롤 외곽선, 헤더 룰" },
        "default": { "$value": "{color.gray.300}", "$description": "플롯 프레임, 푸터 룰" },
        "subtle":  { "$value": "{color.gray.200}", "$description": "테이블 행 구분" },
        "faint":   { "$value": "{color.gray.100}", "$description": "플롯 내부 격자" }
      },
      "inverse": {
        "bg":  { "$value": "{color.ink}" },
        "ink": { "$value": "{color.paper}" }
      },
      "signal": {
        "mark":    { "$value": "{color.red.mark}", "$description": "포인터, 플레이헤드, 마커, 큰 리드아웃 — 비텍스트/대형 텍스트 (≥3:1)" },
        "fill":    { "$value": "{color.red.fill}", "$description": "글자를 얹는 시그널 채움" },
        "on":      { "$value": "{color.paper}" },
        "text":    { "$value": "{color.red.text}", "$description": "작은 시그널 글자 (≥4.5:1)" },
        "washPct": { "$value": "12%" }
      },
      "diff": {
        "addHue":  { "$value": "{color.diff.add}" },
        "delHue":  { "$value": "{color.diff.del}" },
        "tintPct": { "$value": "10%", "$description": "삭제 줄의 ink.tertiary가 4.5:1을 넘는 최대치" }
      }
    },

    "dark": {
      "scheme": { "$value": "dark" },
      "bg": {
        "canvas": { "$value": "{color.night}" },
        "panel":  { "$value": "{color.night}" },
        "sunken": { "$value": "{color.gray.925}" },
        "hover":  { "$value": "{color.gray.900}" },
        "scrim":  { "$value": "rgba(13, 13, 13, 0.72)" }
      },
      "ink": {
        "primary":   { "$value": "{color.chalk}" },
        "secondary": { "$value": "{color.gray.400}" },
        "tertiary":  { "$value": "{color.gray.500}" },
        "disabled":  { "$value": "{color.gray.800}" }
      },
      "line": {
        "strong":  { "$value": "{color.chalk}" },
        "default": { "$value": "{color.gray.800}" },
        "subtle":  { "$value": "{color.gray.850}" },
        "faint":   { "$value": "{color.gray.900}" }
      },
      "inverse": {
        "bg":  { "$value": "{color.chalk}" },
        "ink": { "$value": "{color.night}" }
      },
      "signal": {
        "mark":    { "$value": "{color.red.markDark}" },
        "fill":    { "$value": "{color.red.mark}" },
        "on":      { "$value": "{color.night}" },
        "text":    { "$value": "{color.red.textDark}" },
        "washPct": { "$value": "22%" }
      },
      "diff": {
        "addHue":  { "$value": "{color.diff.addDark}" },
        "delHue":  { "$value": "{color.diff.delDark}" },
        "tintPct": { "$value": "22%" }
      }
    },

    "derived": {
      "$description": "다른 시맨틱 역할에서 계산되는 값. 시그널/종이/테마를 바꾸는 모든 스코프에서 다시 계산되도록 별도 블록으로 출력된다.",
      "signal": {
        "wash": { "$value": "color-mix(in srgb, {signal.mark} {signal.washPct}, {bg.canvas})", "$description": "선택 영역, 수정된 행 라벨, 호버 틴트" }
      },
      "focus": {
        "ring": { "$value": "{signal.mark}" }
      },
      "diff": {
        "mix": { "$value": "calc({diff.tintPct} * {diff.on} * {diff.allow})", "$description": "켜짐(data-diff) × 허용(시그널) × 틴트. 둘 중 하나라도 0이면 단색 diff" },
        "add": { "$value": "color-mix(in srgb, {diff.addHue} {diff.mix}, {bg.sunken})", "$description": "추가 줄 배경 — 단색일 땐 bg.sunken 그대로" },
        "del": { "$value": "color-mix(in srgb, {diff.delHue} {diff.mix}, transparent)", "$description": "삭제 줄 배경 — 단색일 땐 투명" }
      }
    }
  },

  "variant": {
    "signal": {
      "blue": {
        "light": { "signal": {
          "mark": { "$value": "{color.blue.mark}" },
          "fill": { "$value": "{color.blue.mark}" },
          "text": { "$value": "{color.blue.text}" }
        }, "diff": { "allow": { "$value": "1", "$description": "초록/빨강 diff 틴트는 파랑 시그널에서만 — 빨강·주황 시그널 워시와 색이 겹친다" } } },
        "dark": { "signal": {
          "mark": { "$value": "{color.blue.markDark}" },
          "fill": { "$value": "{color.blue.markDark}" },
          "text": { "$value": "{color.blue.textDark}" }
        }, "diff": { "allow": { "$value": "1" } } }
      },
      "orange": {
        "light": { "signal": {
          "mark": { "$value": "{color.orange.mark}" },
          "fill": { "$value": "{color.orange.fill}" },
          "text": { "$value": "{color.orange.text}" }
        } },
        "dark": { "signal": {
          "mark": { "$value": "{color.orange.mark}" },
          "fill": { "$value": "{color.orange.mark}" },
          "text": { "$value": "{color.orange.textDark}" }
        } }
      }
    },
    "paper": {
      "warm": {
        "light": {
          "bg": {
            "canvas": { "$value": "{color.paperWarm}" },
            "panel":  { "$value": "{color.paperWarm}" },
            "sunken": { "$value": "{color.paperWarmDeep}" },
            "hover":  { "$value": "{color.paperWarmDeep}" },
            "scrim":  { "$value": "rgba(232, 231, 224, 0.72)" }
          },
          "ink": {
            "secondary": { "$value": "{color.gray.750}" },
            "tertiary":  { "$value": "{color.gray.700}" }
          },
          "line": {
            "default": { "$value": "{color.gray.400}" },
            "subtle":  { "$value": "{color.gray.300}" },
            "faint":   { "$value": "{color.paperWarmDeep}" }
          },
          "inverse": { "ink": { "$value": "{color.paperWarm}" } }
        }
      }
    },
    "diff": {
      "hue": {
        "$description": "코드 리뷰가 주 업무인 화면용 opt-in. 추가/삭제 줄에 옅은 초록/빨강 배경. 시그널이 blue가 아니면 diff.allow=0이라 단색으로 남는다.",
        "base": { "diff": { "on": { "$value": "1" } } }
      }
    },
    "dialect": {
      "soft": {
        "$description": "sprig/cut 계열. 반경과 컨트롤 글꼴만 바뀐다. 색·선·숫자 문법은 그대로.",
        "base": {
          "radius": {
            "control": { "$value": "{radius.pill}" },
            "panel":   { "$value": "{radius.soft}" }
          },
          "font": {
            "control": { "$value": "{font.family.sans}" },
            "controlCase": { "$value": "none" },
            "controlTracking": { "$value": "{font.tracking.none}" }
          }
        }
      }
    }
  }
}
